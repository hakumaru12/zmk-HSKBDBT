// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
// mouse.h は削除 ↓
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10

/ {
    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.

    combos {
        compatible = "zmk,combos";

        jp {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <12 13>;
        };

        en {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <16 17>;
        };

        TABGUI {
            bindings = <&kp LG(TAB)>;
            key-positions = <16 17 18>;
        };

        LINE_SEND {
            bindings = <&kp RA(ENTER)>;
            key-positions = <37 25>;
        };
        ZENHAN {
            bindings = <&kp LANG_ZENKAKUHANKAKU>;
            key-positions = <11 12 13>;
        };
        TW_POST {
            bindings = <&kp RC(ENTER)>;
            key-positions = <37 26>;
        };
    };

    macros {
        pswd: pswd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N8 &kp N2 &kp N5>;
            label = "PSWD";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Sensor order follows `sensor-bindings = <&left_encoder &right_encoder>` in dtsi.


        default_layer {
            bindings = <
&kp Q           &kp L     &kp U    &kp COMMA  &kp DOT                    &kp F      &kp W      &kp R     &kp Y     &kp P
&kp E           &kp I     &kp A    &kp O      &kp MINUS                  &kp K      &kp T      &kp N     &kp S     &kp H
&kp Z           &kp X     &kp C    &kp V      &kp SEMICOLON              &kp G      &kp D      &kp M     &kp J     &kp B
&kp LCTRL       &kp LGUI  &kp TAB    &kp LSHFT  &kp DEL    &to 1  &to 0  &kp ENTER  &kp SPACE  &kp BSPC  &kp RALT  &kp SLASH
>;

            sensor-bindings =
                <&inc_dec_kp C_NEXT C_PREV>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_1 {
            bindings = <
&kp N1        &kp N2        &kp N3        &kp N4         &kp N5                         &kp N6       &kp N7    &kp N8    &kp N9     &kp N0
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_CLR_ALL                 &kp LBKT       &pswd     &kp UP    &kp EQUAL  &kp RBKT
&to 0         &to 2         &to 3         &pswd          &kp SINGLE_QUOTE               &kp INT_YEN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp NON_US_HASH
&kp LCTRL     &kp ESC      &trans       &trans         &trans          &trans  &to 0  &trans       &trans    &trans    &trans     &kp INT_RO
            >;

            sensor-bindings =
                <&inc_dec_kp C_NEXT C_PREV>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_2 {
            bindings = <
&kp Q   &kp W   &kp E   &kp R   &kp T                  &kp Y   &kp U   &kp I      &kp O    &kp P
&kp A   &kp S   &kp D   &kp F   &kp G                  &kp H   &kp J   &kp K      &kp L    &kp MINUS
&kp Z   &kp X   &kp C   &kp V   &kp B                  &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH
&trans  &trans  &trans   &trans  &trans  &trans  &to 0  &trans  &trans  &trans     &trans   &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_NEXT C_PREV>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            bindings = <
&msc SCRL_LEFT  &msc SCRL_UP    &mkp MCLK       &msc SCRL_DOWN   &msc SCRL_RIGHT                &msc SCRL_LEFT  &msc SCRL_UP    &mkp MCLK       &msc SCRL_DOWN   &msc SCRL_RIGHT
&mkp MB5        &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &none                          &mkp MB5        &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &none
&mkp MB4        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none                          &mkp MB4        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none
&none           &none           &none           &none            &none           &none  &to 0   &none           &none           &none           &none            &none
            >;
            sensor-bindings =
                <&inc_dec_kp C_NEXT C_PREV>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
